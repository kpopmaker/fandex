{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "app/api/internal/naver-news/shadow-scheduler/route.ts": {
      "regions": [
        "sin1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/internal/naver-news/vercel-cron-fallback",
      "schedule": "17 * * * *"
    }
  ]
}
