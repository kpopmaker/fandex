  "requested_enrichment_field_contract": {
    "fields": ["content_context", "source_attribution"],
    "canonical_order": ["content_context", "source_attribution"],
    "authority": "validated_v72"
  },
  "fulfillment_lifecycle": [
    {"state":"requested","definition":"The canonical field is present in the human request and has not been planned."},
    {"state":"planned","definition":"A data-only local-first plan exists; no retrieval is implied."},
    {"state":"not_attempted","definition":"No evidence acquisition was attempted, including when authorization is absent."},
    {"state":"evidence_available","definition":"Candidate evidence exists but completion validation has not succeeded."},
    {"state":"partially_satisfied","definition":"Some but not all required semantic components validate for the field."},
    {"state":"satisfied","definition":"Every field-specific completion requirement validates."},
    {"state":"unavailable","definition":"Authorized or local inspection completed without the required evidence."},
    {"state":"failed","definition":"A deterministic validation or acquisition failure prevented evaluation."}
  ],
  "request_level_statuses": {
    "vocabulary": ["not_attempted", "unsatisfied", "partially_satisfied", "satisfied", "unavailable", "failed"],
    "precedence": ["satisfied", "partially_satisfied", "failed", "unavailable", "not_attempted", "unsatisfied"],
    "rules": {
      "satisfied":"all requested fields are satisfied",
      "partially_satisfied":"at least one but not all requested fields are satisfied",
      "failed":"none are satisfied and at least one is failed",
      "unavailable":"none are satisfied or failed and at least one is unavailable",
      "not_attempted":"all fields are requested, planned, or not_attempted",
      "unsatisfied":"none are satisfied and evidence is absent or incomplete without a terminal failure"
    }
  },
  "source_class_vocabulary": [
    {"key":"existing_local_normalized","external":false,"authorized_in_v74":true,"definition":"Already stored normalized/canonical or review-queue evidence."},
    {"key":"controlled_fixture_input","external":false,"authorized_in_v74":true,"definition":"Synthetic deterministic test evidence, never real-source fact."},
    {"key":"authorized_provider_retrieval","external":true,"authorized_in_v74":false,"definition":"Future provider-mediated retrieval requiring a separate authorization envelope."},
    {"key":"authorized_direct_source_retrieval","external":true,"authorized_in_v74":false,"definition":"Future direct source retrieval requiring separately reviewed authorization and network controls."}
  ],
  "source_priority": ["existing_local_normalized", "controlled_fixture_input", "authorized_provider_retrieval", "authorized_direct_source_retrieval"],
  "source_priority_rules": ["evaluate authoritative local evidence first", "stop when the field completion rule is satisfied", "treat external classes as candidates until explicitly authorized", "never fallback to web search or another provider"],
  "content_context_completion": {
    "required_semantic_fields": ["title", "summary_or_bounded_excerpt"],
