  "proposed_application_lifecycle": {
    "provenance": "proposed_v65",
    "states": [
      {"status": "prepared", "meaning": "validated and gate-eligible logical application is ready for one atomic attempt", "entry_conditions": ["v61_valid", "v62_valid", "v63_eligible", "expected_state_fingerprint_matches", "no_conflicting_applied_record"], "allowed_next_states": ["applied", "failed", "conflict"], "terminal": false},
      {"status": "applied", "meaning": "all logical application writes completed atomically", "entry_conditions": ["prepared", "atomic_boundary_succeeded"], "allowed_next_states": [], "terminal": true},
      {"status": "failed", "meaning": "attempt produced no logical writes", "entry_conditions": ["prepared", "non_conflict_failure"], "allowed_next_states": ["prepared"], "terminal": false},
      {"status": "conflict", "meaning": "expected state, duplicate, or already-applied check failed with no logical writes", "entry_conditions": ["prepared", "state_or_identity_conflict"], "allowed_next_states": ["prepared"], "terminal": false}
    ],
    "retry_precondition": "fresh_v61_v62_v63_validation_and_new_expected_state_fingerprint_required"
  },
