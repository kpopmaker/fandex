    "conditional_fields": {"requested_enrichment_fields": "required_only_for_request_enrichment", "applied_at": "required_only_when_application_status_is_applied", "failure_reason_code": "required_only_for_failed_or_conflict"},
    "optional_fields": ["reviewer_note"],
    "timestamp_policy": "future_executor_supplies_validated_ISO_8601_values; v65_generates_none",
    "reviewer_note_policy": "persist_in_restricted_canonical_record_only_when_supplied; omit_from_safe_summaries"
  },
  "proposed_metadata_policy": {
    "provenance": "proposed_v65",
    "reviewer_id": "required_and_persisted_for_explicit_intents",
    "reviewed_at": "validated_if_supplied_historically; proposed_required_and_persisted_for_explicit_intents",
    "rationale_codes": "required_and_persisted_for_explicit_intents",
    "reviewer_note": "optional_restricted_persistence_not_in_safe_summary",
    "not_decided": "historical_null_or_empty_metadata_preserved_and_no_application_record"
  },
  "proposed_idempotency_rule": {
    "provenance": "proposed_v65",
    "algorithm": "sha256_canonical_join",
    "ordered_components": ["proposal_contract_version", "decision_input_id", "decision_preview_id", "queue_id", "gate_id", "internal_source_id", "decision_intent", "input_hash", "historical_state_hash"],
    "identical_retry": "return_existing_applied_result_without_new_logical_writes",
    "same_key_different_payload": "conflict_fail_closed",
    "different_decision_same_target": "conflict_if_target_is_resolved; requires_separate_reopen_and_new_validated_input"
  },
  "proposed_stale_state_rule": {
    "provenance": "proposed_v65",
    "fingerprint": "sha256_of_canonical_minimal_target_state_including_linkage_queue_status_current_decision_status_and_existing_application_identity",
    "comparison_point": "immediately_before_atomic_logical_application",
    "mismatch_result": "conflict",
    "write_policy": "fail_closed_no_logical_writes"
  },
  "proposed_logical_transaction_boundary": {
    "provenance": "proposed_v65",
    "atomic_logical_writes": ["decision_application_record", "decision_outcome_state", "review_queue_state", "audit_event"],
