    "test:ingestion:v125": "tsx --test tests/naver-news-scheduler-v125.test.mts",
    "test:ingestion:v126": "tsx --test tests/naver-news-scheduler-dispatch-v126.test.mts",
    "test:ingestion:v127": "tsx --test tests/naver-news-monitoring-v127.test.mts",
    "test:ingestion:v128": "tsx --test tests/naver-news-recurring-scheduler-v128.test.mts",
    "ingestion:naver-news:plan": "tsx scripts/ingestion/plan-naver-news-v121.mts",
