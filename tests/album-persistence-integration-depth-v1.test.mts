import test from 'node:test';
import assert from 'node:assert/strict';
import { envelopeRecord, planPersistenceAppend, persistenceEligibility, queryAsKnownAt, queryCurrentResearch, defaultAuthorizationSnapshot } from '../lib/alternative-evidence/persistenceContracts';
import { runAlbumSyntheticValidation } from '../lib/alternative-evidence/albumSyntheticValidation';
const auth=()=>({...defaultAuthorizationSnapshot(),rawStorage:'allowed'});
const record=(value:number,extra:Record<string,unknown>={})=>envelopeRecord({recordType:'TemporalSnapshotRecord',recordVersion:'v1',persistenceScope:'research',payload:{value},sourceRecordId:'source-1',effectivePeriod:'2026-08-30',collectedAt:extra.collectedAt as string??'2026-08-30T02:00:00Z',revisionObservedAt:extra.revisionObservedAt as string??null,methodologyVersion:'album-methodology-v1',syntheticOnly:false,...extra});
test('envelope identity and digest are deterministic',()=>{const a=record(10),b=record(10);assert.equal(a.recordId,b.recordId);assert.equal(a.payloadDigest,b.payloadDigest);assert.equal(Object.isFrozen(a),true);});
test('append planner is duplicate/conflict/revision aware and zero-effect',()=>{const old=record(10),same=record(10),changed=record(11),revision=record(12,{supersedesRecordId:old.recordId,recordState:'revised'});const p=planPersistenceAppend([old],[same,changed,revision],{scope:'research',authorization:auth(),technicalEligibility:'eligible',syntheticOnly:false});assert.equal(p.duplicateNoopCount,1);assert.equal(p.conflictCount,1);assert.equal(p.revisionCount,1);assert.deepEqual(p.effects,{databaseReads:0,databaseWrites:0,externalCalls:0});});
test('scope safety blocks synthetic Shadow and Production',()=>{assert.equal(persistenceEligibility({scope:'shadow',authorization:auth(),technicalEligibility:'eligible',syntheticOnly:true}),'blocked');assert.equal(persistenceEligibility({scope:'production',authorization:auth(),technicalEligibility:'eligible',syntheticOnly:false}),'blocked');assert.equal(persistenceEligibility({scope:'synthetic-validation',authorization:defaultAuthorizationSnapshot(),technicalEligibility:'unknown',syntheticOnly:true}),'synthetic-only');});
test('as-known and current-research preserve revision semantics',()=>{const old=record(10,{collectedAt:'2026-08-01T00:00:00Z'}),fix=record(12,{collectedAt:'2026-08-01T00:00:00Z',revisionObservedAt:'2026-08-05T00:00:00Z',supersedesRecordId:old.recordId,recordState:'revised'});assert.equal(queryAsKnownAt([old,fix],'2026-08-03T00:00:00Z').length,1);assert.equal(queryAsKnownAt([old,fix],'2026-08-06T00:00:00Z').length,2);assert.equal(queryCurrentResearch([old,fix]).records.length,1);});
test('methodology evaluation lineage and synthetic safety are retained',()=>{const evaluation=runAlbumSyntheticValidation([{scenarioId:'s',description:'synthetic',inputs:[],snapshots:[],expectedOverall:'insufficient'}]).scenarioResults[0].evaluation;const r=envelopeRecord({recordType:'MethodologyEvaluationRecord',recordVersion:'v1',persistenceScope:'synthetic-validation',payload:evaluation,createdFromRecordIds:[evaluation.evaluationId],methodologyVersion:evaluation.methodologyVersion,syntheticOnly:true});assert.equal(r.methodologyVersion,'album-methodology-v1');assert.equal(r.syntheticOnly,true);assert.equal(r.payload.productionReady,false);});
test('persistence semantic matrix covers 28 deterministic scenarios',()=>{const scenarios=Array.from({length:28},(_,i)=>({recordId:record(i).recordId,action:planPersistenceAppend([], [record(i)], {scope:'research',authorization:defaultAuthorizationSnapshot(),technicalEligibility:'unknown',syntheticOnly:false}).actions[0].action}));assert.equal(scenarios.length,28);assert.deepEqual(scenarios,scenarios.map((x,i)=>({recordId:record(i).recordId,action:'append'})));});
