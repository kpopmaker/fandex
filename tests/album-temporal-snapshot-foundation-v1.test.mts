import test from 'node:test'; import assert from 'node:assert/strict';
import { fromCanonicalAlbumFeatureInput, deriveCumulativeDeltas, selectAsKnownAt, assessWindow, makeTemporalWindow, compareTemporalSnapshots } from '../lib/alternative-evidence/albumTemporalSnapshot';
const input=(o:Record<string,unknown>)=>({featureInputId:'f'+String(o.semantic),featureInputFamilyId:null,featureKey:o.semantic==='cumulative-sale'?'reportedCumulativeSales':'providerNativePeriodSales',featureRole:o.semantic==='cumulative-sale'?'context':'absolute',sourceClass:'direct-provider',sourceEvidenceId:'e',sourceObservationId:'o',contributionIdentity:{contributionIdentityId:'c'+String(o.period),sourceEvidenceId:'e',claimFamilyId:null,underlyingObservationId:'o',scopeKey:'r'},provenance:{origin:'direct-licensed-provider',acquisitionProvider:'p',reportedProvider:'p',sourceUrl:null,evidenceDigest:'d',researchOnly:true},artistId:'a',artistIdentityState:'resolved',releaseId:'r',releaseIdentityState:'resolved',releaseFamilyId:null,editionId:null,skuId:null,semantic:o.semantic,value:o.value,unit:'physical-units',territory:'Korea',format:'CD',providerPeriod:o.period,reportedPeriod:null,sourcePublishedAt:null,providerPublishedAt:null,observedAt:'2025-01-01',collectedAt:o.collected??'2025-01-01',revisionObservedAt:o.revision??null,knowledgeMode:'as-known-at-collection',periodType:o.semantic==='cumulative-sale'?'day':'provider-native-period',availabilityState:o.value===null?'missing':'available',qualityState:'clear',eligibilityState:'feature-resolver-candidate',proxyFallbackState:'absolute-available',comparabilityState:'comparable',crossSourceDuplicationState:'unknown',retailerId:null,retailerProductId:null,categoryFamily:null,providerCategoryId:null,categoryResolutionState:null,chartType:null,movementType:null,aggregationScope:null,parentInputId:null,blockers:[]} as never);
test('period separation and series kinds',()=>{const s=fromCanonicalAlbumFeatureInput(input({semantic:'period-sale',value:20,period:'2025-01-01'}));assert.equal(s.seriesKind,'native-period');assert.equal(s.providerPeriodStart,'2025-01-01');});
test('cumulative delta first/null positive/negative',()=>{const a=fromCanonicalAlbumFeatureInput(input({semantic:'cumulative-sale',value:100,period:'2025-01-01'}));const b=fromCanonicalAlbumFeatureInput(input({semantic:'cumulative-sale',value:180,period:'2025-01-02'}));const c=fromCanonicalAlbumFeatureInput(input({semantic:'cumulative-sale',value:150,period:'2025-01-03'}));const d=deriveCumulativeDeltas([a,b,c]);assert.equal(d[0].state,'first-observation');assert.equal(d[1].delta,80);assert.equal(d[2].state,'negative-delta');});
test('as-known cutoff and strict window',()=>{const a=fromCanonicalAlbumFeatureInput(input({semantic:'period-sale',value:1,period:'2025-01-01',collected:'2025-01-02'}));const b=fromCanonicalAlbumFeatureInput(input({semantic:'period-sale',value:2,period:'2025-01-02',collected:'2025-02-01'}));assert.equal(selectAsKnownAt([a,b],'2025-01-15').length,1);const w=assessWindow([a],makeTemporalWindow('2025-01-01','2025-01-07','day',7));assert.equal(w.completeness,'partial');});
test('first-week is not calendar-week',()=>{const a=fromCanonicalAlbumFeatureInput(Object.assign({}, input({semantic:'first-week-sale',value:1,period:'first-week'}), { periodType:'first-week' }) as never);const b=fromCanonicalAlbumFeatureInput(input({semantic:'period-sale',value:1,period:'2025-01-01'}));assert.equal(a.periodType,'first-week');assert.equal(compareTemporalSnapshots(a,b),'not-comparable');});
