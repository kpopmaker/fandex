test('deterministic and non-comparable',()=>{const a=fromRetailObservation(r('retail-rank',3),e('authorized-public-api'))[0];const b=fromDirectAlbumObservation(d('period-sale','physical-units'),e('direct-licensed-provider'))[0];assert.equal(a.featureInputId,fromRetailObservation(r('retail-rank',3),e('authorized-public-api'))[0].featureInputId);assert.equal(classifyAlbumFeatureComparability(a,b),'not-comparable');});
